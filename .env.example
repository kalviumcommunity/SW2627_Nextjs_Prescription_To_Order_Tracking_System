# Database Config (PostgreSQL)
# These map to Docker Compose settings
POSTGRES_USER="medeasy_user"
POSTGRES_PASSWORD="medeasy_password"
POSTGRES_DB="medeasy"
DATABASE_URL="postgresql://medeasy_user:medeasy_password@localhost:5432/medeasy?schema=public"

# Authentication (NextAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# GCP Cloud Storage
GCP_PROJECT_ID=""
GCP_CLIENT_EMAIL=""
GCP_PRIVATE_KEY=""
GCP_STORAGE_BUCKET=""
