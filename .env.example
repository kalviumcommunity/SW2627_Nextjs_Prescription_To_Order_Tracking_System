# =============================================================================
# MedEasy — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values before starting the app.
#
#   cp .env.example .env
#
# NEVER commit your .env file. It is listed in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Node environment
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database — PostgreSQL
# These values must match the docker-compose.yml POSTGRES_* environment vars.
# For local Docker development the defaults below work out of the box.
# -----------------------------------------------------------------------------
POSTGRES_USER=medeasy_dev
POSTGRES_PASSWORD=change_me_local_dev_only
POSTGRES_DB=medeasy_db

# Full connection string used by Prisma.
# When running Next.js on the HOST (not inside Docker) use localhost:
DATABASE_URL="postgresql://medeasy_dev:change_me_local_dev_only@localhost:5432/medeasy_db?schema=public"
# When running Next.js INSIDE Docker Compose use the service hostname (db):
# DATABASE_URL="postgresql://medeasy_dev:change_me_local_dev_only@db:5432/medeasy_db?schema=public"

# -----------------------------------------------------------------------------
# Authentication — NextAuth.js
# Generate a secret: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace_with_output_of_openssl_rand_base64_32"

# -----------------------------------------------------------------------------
# GCP Cloud Storage (leave empty for local development)
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=""
GCP_CLIENT_EMAIL=""
GCP_PRIVATE_KEY=""
GCP_STORAGE_BUCKET=""
